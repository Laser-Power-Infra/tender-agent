# PostgreSQL connection for SQLModel + psycopg (psycopg3)
# Format: postgresql+psycopg://user:password@host:port/dbname
# Note: 'postgresql://' also works and will be normalized to 'postgresql+psycopg://' automatically.
# Special chars in password must be URL-encoded.
DATABASE_URL="postgresql+psycopg://asmita:asmita@192.168.1.190:5432/tender-agent-database"
# Optional:
# DB_ECHO=false
