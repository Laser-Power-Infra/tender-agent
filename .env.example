# PostgreSQL connection for SQLModel + psycopg (psycopg3)
# Format: postgresql+psycopg://user:password@host:port/dbname
# Note: 'postgresql://' also works and will be normalized to 'postgresql+psycopg://' automatically.
# Special chars in password must be URL-encoded.
DATABASE_URL="postgresql+psycopg://asmita:asmita@192.168.1.190:5432/tender-agent-database"
# Optional:
# DB_ECHO=false
QDRANT_URL="http://192.168.1.190:9001"
QDRANT_API_KEY="bidyutasmitautsabminmoy"
RABBITMQ_URL="amqp://guest:guest@192.168.1.190:5672"
TEMP_DIR="D://tmp/"

# Langfuse observability (disabled by default - dependency kept for later)
# LANGFUSE_ENABLED=false  # set to true to enable tracing
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_HOST="https://cloud.langfuse.com"  # or self-hosted URL

# Google Drive OAuth (required for drive.google.com links) - 3 env vars, no file
# - Create OAuth 2.0 Client ID (Desktop App) in Google Cloud Console, enable Drive API
# - Generate refresh_token via OAuth flow with scope https://www.googleapis.com/auth/drive.readonly (offline access)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
GOOGLE_OAUTH_TOKEN_URI="https://oauth2.googleapis.com/token"  # optional, defaults to this

# OpenAI embeddings (dense) + Qdrant hybrid + chunking
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"  # dims 1536, use text-embedding-3-large for 3072
EMBEDDING_BATCH_SIZE="100"
QDRANT_COLLECTION="tender_chunks"
CHUNK_SIZE="1000"
CHUNK_OVERLAP="200"
